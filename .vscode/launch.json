{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Wencry -V (版本信息)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "args": ["-V"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "CMake: build",
            "console": "integratedTerminal"
        },
        {
            "name": "Wencry 交互模式",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "CMake: build",
            "console": "integratedTerminal"
        },
        {
            "name": "Wencry 加密文件 (示例)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "args": [
                "-e", "-i", "${workspaceFolder}/sample.txt",
                "--cmode", "1", "-o", "${workspaceFolder}/sample.txt.wenc"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "CMake: build",
            "console": "integratedTerminal"
        }
    ]
}
